<?xml version="1.0"?>
<!--
  Sound configuration for the web version's Boeing 737 MAX 8, in
  FlightGear's sound XML format, with the 737-family project's recordings
  (SASA's CFM56 set and the project's callouts, GPL-2.0).  The project's own
  leapx-sound.xml is driven by Nasal it does not include yet, so this is a
  smaller set driven by the properties the web version has.

  Generated with the engines' two blocks alike; build: tools/build_737.sh.
-->
<PropertyList>
 <fx>

  <!-- Engine 1 (left), outside: idle whine, spool-up, fan buzz, the roar behind it -->
  <engine>
   <name>ext-idle-0</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-idle.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[0]/n2</property><value>8</value></greater-than></condition>
   <volume><property>/engines/engine[0]/n2</property><factor>0.011</factor><max>0.7</max></volume>
   <pitch><property>/engines/engine[0]/n2</property><factor>0.0075</factor><offset>0.55</offset></pitch>
   <reference-dist>30</reference-dist>
   <max-dist>3000</max-dist>
  </engine>
  <engine>
   <name>ext-spool-0</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-spool.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[0]/n1</property><value>24</value></greater-than></condition>
   <!-- 0 at 24% N1, full at 84% -->
   <volume><property>/engines/engine[0]/n1</property><factor>0.0167</factor><offset>-0.4</offset></volume>
   <pitch><property>/engines/engine[0]/n1</property><factor>0.006</factor><offset>0.5</offset></pitch>
   <reference-dist>40</reference-dist>
   <max-dist>5000</max-dist>
  </engine>
  <engine>
   <name>ext-buzz-0</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-buzz.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[0]/n1</property><value>60</value></greater-than></condition>
   <volume><property>/engines/engine[0]/n1</property><factor>0.02</factor><offset>-1.2</offset></volume>
   <pitch><property>/engines/engine[0]/n1</property><factor>0.006</factor><offset>0.4</offset></pitch>
   <reference-dist>40</reference-dist>
   <max-dist>5000</max-dist>
  </engine>
  <engine>
   <name>ext-rumble-0</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-rumble.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[0]/thrust_lb</property><value>4000</value></greater-than></condition>
   <volume><property>/engines/engine[0]/thrust_lb</property><factor>0.00003</factor><max>0.9</max></volume>
   <reference-dist>50</reference-dist>
   <max-dist>6000</max-dist>
  </engine>
  <engine>
   <name>ext-reverse-0</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-reverse.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[0]/reverser-pos-norm</property><value>0.5</value></greater-than>
    <greater-than><property>/engines/engine[0]/n1</property><value>30</value></greater-than></condition>
   <volume><property>/engines/engine[0]/n1</property><factor>0.012</factor><max>0.9</max></volume>
   <pitch><property>/engines/engine[0]/n1</property><factor>0.004</factor><offset>0.75</offset></pitch>
   <reference-dist>40</reference-dist>
   <max-dist>4000</max-dist>
  </engine>
  <engine>
   <name>starter-0</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/start/737_cockpit_starter.wav</path>
   <condition><property>/engines/engine[0]/starter</property></condition>
   <volume><factor>0.7</factor></volume>
   <reference-dist>20</reference-dist>
   <max-dist>800</max-dist>
  </engine>

  <!-- Engine 1, in the cockpit -->
  <engine>
   <name>int-idle-0</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/cockpit/cfm-idle.wav</path>
   <condition><property>/sim/current-view/internal</property><greater-than><property>/engines/engine[0]/n2</property><value>8</value></greater-than></condition>
   <volume><property>/engines/engine[0]/n2</property><factor>0.005</factor><max>0.35</max></volume>
   <pitch><property>/engines/engine[0]/n1</property><factor>0.006</factor><offset>0.88</offset></pitch>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </engine>
  <engine>
   <name>int-spool-0</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-spool.wav</path>
   <condition><property>/sim/current-view/internal</property><greater-than><property>/engines/engine[0]/n1</property><value>30</value></greater-than></condition>
   <volume><property>/engines/engine[0]/n1</property><factor>0.006</factor><offset>-0.18</offset></volume>
   <pitch><property>/engines/engine[0]/n1</property><factor>0.006</factor><offset>0.5</offset></pitch>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </engine>

  <!-- Engine 2 (right), outside: idle whine, spool-up, fan buzz, the roar behind it -->
  <engine>
   <name>ext-idle-1</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-idle.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[1]/n2</property><value>8</value></greater-than></condition>
   <volume><property>/engines/engine[1]/n2</property><factor>0.011</factor><max>0.7</max></volume>
   <pitch><property>/engines/engine[1]/n2</property><factor>0.0075</factor><offset>0.55</offset></pitch>
   <reference-dist>30</reference-dist>
   <max-dist>3000</max-dist>
  </engine>
  <engine>
   <name>ext-spool-1</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-spool.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[1]/n1</property><value>24</value></greater-than></condition>
   <!-- 0 at 24% N1, full at 84% -->
   <volume><property>/engines/engine[1]/n1</property><factor>0.0167</factor><offset>-0.4</offset></volume>
   <pitch><property>/engines/engine[1]/n1</property><factor>0.006</factor><offset>0.5</offset></pitch>
   <reference-dist>40</reference-dist>
   <max-dist>5000</max-dist>
  </engine>
  <engine>
   <name>ext-buzz-1</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-buzz.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[1]/n1</property><value>60</value></greater-than></condition>
   <volume><property>/engines/engine[1]/n1</property><factor>0.02</factor><offset>-1.2</offset></volume>
   <pitch><property>/engines/engine[1]/n1</property><factor>0.006</factor><offset>0.4</offset></pitch>
   <reference-dist>40</reference-dist>
   <max-dist>5000</max-dist>
  </engine>
  <engine>
   <name>ext-rumble-1</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-rumble.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[1]/thrust_lb</property><value>4000</value></greater-than></condition>
   <volume><property>/engines/engine[1]/thrust_lb</property><factor>0.00003</factor><max>0.9</max></volume>
   <reference-dist>50</reference-dist>
   <max-dist>6000</max-dist>
  </engine>
  <engine>
   <name>ext-reverse-1</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-reverse.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not><greater-than><property>/engines/engine[1]/reverser-pos-norm</property><value>0.5</value></greater-than>
    <greater-than><property>/engines/engine[1]/n1</property><value>30</value></greater-than></condition>
   <volume><property>/engines/engine[1]/n1</property><factor>0.012</factor><max>0.9</max></volume>
   <pitch><property>/engines/engine[1]/n1</property><factor>0.004</factor><offset>0.75</offset></pitch>
   <reference-dist>40</reference-dist>
   <max-dist>4000</max-dist>
  </engine>
  <engine>
   <name>starter-1</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/start/737_cockpit_starter.wav</path>
   <condition><property>/engines/engine[1]/starter</property></condition>
   <volume><factor>0.7</factor></volume>
   <reference-dist>20</reference-dist>
   <max-dist>800</max-dist>
  </engine>

  <!-- Engine 2, in the cockpit -->
  <engine>
   <name>int-idle-1</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/cockpit/cfm-idle.wav</path>
   <condition><property>/sim/current-view/internal</property><greater-than><property>/engines/engine[1]/n2</property><value>8</value></greater-than></condition>
   <volume><property>/engines/engine[1]/n2</property><factor>0.005</factor><max>0.35</max></volume>
   <pitch><property>/engines/engine[1]/n1</property><factor>0.006</factor><offset>0.88</offset></pitch>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </engine>
  <engine>
   <name>int-spool-1</name>
   <mode>looped</mode>
   <path>Sounds/SASA/CFM56B/external/cfm-spool.wav</path>
   <condition><property>/sim/current-view/internal</property><greater-than><property>/engines/engine[1]/n1</property><value>30</value></greater-than></condition>
   <volume><property>/engines/engine[1]/n1</property><factor>0.006</factor><offset>-0.18</offset></volume>
   <pitch><property>/engines/engine[1]/n1</property><factor>0.006</factor><offset>0.5</offset></pitch>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </engine>

  <!-- APU -->
  <apu>
   <name>apu</name>
   <mode>looped</mode>
   <path>Sounds/SASA/737_apu.wav</path>
   <condition><greater-than><property>/engines/engine[2]/n2</property><value>5</value></greater-than></condition>
   <volume><property>/engines/engine[2]/n2</property><factor>0.006</factor><max>0.6</max></volume>
   <pitch><property>/engines/engine[2]/n2</property><factor>0.005</factor><offset>0.5</offset></pitch>
   <reference-dist>15</reference-dist>
   <max-dist>800</max-dist>
  </apu>

  <!-- Airflow -->
  <wind>
   <name>wind-int</name>
   <mode>looped</mode>
   <path>Sounds/SASA/wind_cockpit.wav</path>
   <condition><property>/sim/current-view/internal</property>
    <greater-than><property>/velocities/airspeed-kt</property><value>60</value></greater-than></condition>
   <volume><property>/velocities/airspeed-kt</property><factor>0.0018</factor><max>0.7</max></volume>
   <pitch><property>/velocities/airspeed-kt</property><factor>0.0012</factor><offset>0.75</offset></pitch>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </wind>
  <wind>
   <name>wind-ext</name>
   <mode>looped</mode>
   <path>Sounds/Wind.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not>
    <greater-than><property>/velocities/airspeed-kt</property><value>60</value></greater-than></condition>
   <volume><property>/velocities/airspeed-kt</property><factor>0.0015</factor><max>0.6</max></volume>
   <pitch><property>/velocities/airspeed-kt</property><factor>0.001</factor><offset>0.8</offset></pitch>
   <reference-dist>20</reference-dist>
   <max-dist>800</max-dist>
  </wind>

  <!-- Gear, flaps and wheels -->
  <gear>
   <name>gear-transit</name>
   <mode>in-transit</mode>
   <path>Sounds/SASA/737_gear.wav</path>
   <property>/gear/gear[0]/position-norm</property>
   <volume><factor>0.8</factor></volume>
   <reference-dist>10</reference-dist>
   <max-dist>300</max-dist>
  </gear>
  <flaps>
   <name>flaps</name>
   <mode>in-transit</mode>
   <path>Sounds/SASA/737_flapmotor.wav</path>
   <property>/surface-positions/flap-pos-norm</property>
   <volume><factor>0.5</factor></volume>
   <reference-dist>10</reference-dist>
   <max-dist>200</max-dist>
  </flaps>
  <gear>
   <name>touchdown</name>
   <mode>once</mode>
   <path>Sounds/SASA/Touch-Main.wav</path>
   <condition>
    <or><property>/gear/gear[1]/wow</property><property>/gear/gear[2]/wow</property></or>
    <less-than><property>/velocities/vertical-speed-fps</property><value>-1</value></less-than>
   </condition>
   <volume><property>/velocities/groundspeed-kt</property><factor>0.007</factor><max>1</max></volume>
   <reference-dist>15</reference-dist>
   <max-dist>500</max-dist>
  </gear>
  <gear>
   <name>roll-ext</name>
   <mode>looped</mode>
   <path>Sounds/SASA/Roll.wav</path>
   <condition><not><property>/sim/current-view/internal</property></not>
    <or><property>/gear/gear[1]/wow</property><property>/gear/gear[2]/wow</property></or>
    <greater-than><property>/gear/gear[1]/rollspeed-ms</property><value>2</value></greater-than></condition>
   <volume><property>/velocities/groundspeed-kt</property><factor>0.005</factor><max>0.8</max></volume>
   <pitch><property>/velocities/groundspeed-kt</property><factor>0.003</factor><offset>0.8</offset></pitch>
   <reference-dist>15</reference-dist>
   <max-dist>400</max-dist>
  </gear>
  <gear>
   <name>roll-int</name>
   <mode>looped</mode>
   <path>Sounds/SASA/Cockpit_Roll.wav</path>
   <condition><property>/sim/current-view/internal</property>
    <or><property>/gear/gear[0]/wow</property><property>/gear/gear[1]/wow</property></or>
    <greater-than><property>/gear/gear[0]/rollspeed-ms</property><value>2</value></greater-than></condition>
   <volume><property>/velocities/groundspeed-kt</property><factor>0.006</factor><max>0.8</max></volume>
   <pitch><property>/velocities/groundspeed-kt</property><factor>0.003</factor><offset>0.8</offset></pitch>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </gear>

  <!-- The pushback tug's engine -->
  <tug>
   <name>pushback</name>
   <mode>looped</mode>
   <path>Sounds/pushback.wav</path>
   <condition><property>/sim/model/autopush/connected</property></condition>
   <volume><factor>0.5</factor></volume>
   <reference-dist>10</reference-dist>
   <max-dist>300</max-dist>
  </tug>

  <!-- Stall warning -->
  <stall>
   <name>stall</name>
   <mode>looped</mode>
   <path>Sounds/stall.wav</path>
   <condition><greater-than><property>/sim/alarms/stall-warning</property><value>0.5</value></greater-than>
    <not><property>/gear/gear[1]/wow</property></not></condition>
   <volume><factor>0.8</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </stall>

  <!-- Callouts: the takeoff (80 knots, V1, rotate) and the radio altitude on the approach -->
  <callout>
   <name>eighty-knots</name>
   <mode>once</mode>
   <path>Sounds/80kt.wav</path>
   <condition><greater-than><property>/velocities/airspeed-kt</property><value>80</value></greater-than><property>/gear/gear[1]/wow</property><greater-than><property>/controls/engines/engine[0]/throttle</property><value>0.5</value></greater-than></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>v1</name>
   <mode>once</mode>
   <path>Sounds/v1.wav</path>
   <condition><greater-than><property>/velocities/airspeed-kt</property><value>138</value></greater-than><property>/gear/gear[1]/wow</property><greater-than><property>/controls/engines/engine[0]/throttle</property><value>0.5</value></greater-than></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>rotate</name>
   <mode>once</mode>
   <path>Sounds/vr.wav</path>
   <condition><greater-than><property>/velocities/airspeed-kt</property><value>145</value></greater-than><property>/gear/gear[1]/wow</property><greater-than><property>/controls/engines/engine[0]/throttle</property><value>0.5</value></greater-than></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>gpws-500</name>
   <mode>once</mode>
   <path>Sounds/gpws/altitude-500.wav</path>
   <condition><less-than><property>/position/altitude-agl-ft</property><value>509</value></less-than><greater-than><property>/position/altitude-agl-ft</property><value>469</value></greater-than><greater-than><property>/gear/gear[0]/position-norm</property><value>0.99</value></greater-than><less-than><property>/velocities/vertical-speed-fps</property><value>-2</value></less-than><not><property>/gear/gear[1]/wow</property></not></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>gpws-100</name>
   <mode>once</mode>
   <path>Sounds/gpws/altitude-100.wav</path>
   <condition><less-than><property>/position/altitude-agl-ft</property><value>109</value></less-than><greater-than><property>/position/altitude-agl-ft</property><value>69</value></greater-than><greater-than><property>/gear/gear[0]/position-norm</property><value>0.99</value></greater-than><less-than><property>/velocities/vertical-speed-fps</property><value>-2</value></less-than><not><property>/gear/gear[1]/wow</property></not></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>gpws-50</name>
   <mode>once</mode>
   <path>Sounds/gpws/altitude-50.wav</path>
   <condition><less-than><property>/position/altitude-agl-ft</property><value>59</value></less-than><greater-than><property>/position/altitude-agl-ft</property><value>55</value></greater-than><greater-than><property>/gear/gear[0]/position-norm</property><value>0.99</value></greater-than><less-than><property>/velocities/vertical-speed-fps</property><value>-2</value></less-than><not><property>/gear/gear[1]/wow</property></not></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>gpws-40</name>
   <mode>once</mode>
   <path>Sounds/gpws/altitude-40.wav</path>
   <condition><less-than><property>/position/altitude-agl-ft</property><value>49</value></less-than><greater-than><property>/position/altitude-agl-ft</property><value>45</value></greater-than><greater-than><property>/gear/gear[0]/position-norm</property><value>0.99</value></greater-than><less-than><property>/velocities/vertical-speed-fps</property><value>-2</value></less-than><not><property>/gear/gear[1]/wow</property></not></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>gpws-30</name>
   <mode>once</mode>
   <path>Sounds/gpws/altitude-30.wav</path>
   <condition><less-than><property>/position/altitude-agl-ft</property><value>39</value></less-than><greater-than><property>/position/altitude-agl-ft</property><value>35</value></greater-than><greater-than><property>/gear/gear[0]/position-norm</property><value>0.99</value></greater-than><less-than><property>/velocities/vertical-speed-fps</property><value>-2</value></less-than><not><property>/gear/gear[1]/wow</property></not></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>gpws-20</name>
   <mode>once</mode>
   <path>Sounds/gpws/altitude-20.wav</path>
   <condition><less-than><property>/position/altitude-agl-ft</property><value>29</value></less-than><greater-than><property>/position/altitude-agl-ft</property><value>25</value></greater-than><greater-than><property>/gear/gear[0]/position-norm</property><value>0.99</value></greater-than><less-than><property>/velocities/vertical-speed-fps</property><value>-2</value></less-than><not><property>/gear/gear[1]/wow</property></not></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
  <callout>
   <name>gpws-10</name>
   <mode>once</mode>
   <path>Sounds/gpws/altitude-10.wav</path>
   <condition><less-than><property>/position/altitude-agl-ft</property><value>19</value></less-than><greater-than><property>/position/altitude-agl-ft</property><value>15</value></greater-than><greater-than><property>/gear/gear[0]/position-norm</property><value>0.99</value></greater-than><less-than><property>/velocities/vertical-speed-fps</property><value>-2</value></less-than><not><property>/gear/gear[1]/wow</property></not></condition>
   <volume><factor>0.9</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>200</max-dist>
  </callout>
 </fx>
</PropertyList>
