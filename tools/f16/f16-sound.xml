<?xml version="1.0"?>
<!--
  Sound configuration for the web version's F-16 (JSBSim's F-16 flight model),
  in FlightGear's sound XML format, using recordings from FlightGear's F-16
  (FGAddon Aircraft/f16/Sounds, GPL-2.0-or-later; engine sounds by Carsten
  "GEED" Brueggmann).  FlightGear's own f16-sound.xml depends on that
  aircraft's Nasal systems, so this is a smaller set driven by the properties
  the web version has.

  Build: tools/build_sound.py (see README, "Rebuilding the data").
-->
<PropertyList>
 <fx>

  <!-- Engine, outside: ground idle, military power, the roar behind it, afterburner -->
  <engine>
   <name>ext-idle</name>
   <mode>looped</mode>
   <path>Sounds/GEED/exterior_ground_idle_loop_mono.wav</path>
   <condition>
    <not><property>/sim/current-view/internal</property></not>
    <greater-than><property>/engines/engine[0]/n2</property><value>5</value></greater-than>
   </condition>
   <volume><property>/engines/engine[0]/n2</property><factor>0.014</factor><max>0.8</max></volume>
   <pitch><property>/engines/engine[0]/n2</property><factor>0.012</factor><offset>0.36</offset><max>1.4</max></pitch>
   <reference-dist>25</reference-dist>
   <max-dist>3000</max-dist>
  </engine>

  <engine>
   <name>ext-mil</name>
   <mode>looped</mode>
   <path>Sounds/GEED/mil_exterior.wav</path>
   <condition>
    <not><property>/sim/current-view/internal</property></not>
    <greater-than><property>/engines/engine[0]/n1</property><value>55</value></greater-than>
   </condition>
   <!-- 0 at 60% N1, 1 at 100% -->
   <volume><property>/engines/engine[0]/n1</property><factor>0.025</factor><offset>-1.5</offset></volume>
   <pitch><property>/engines/engine[0]/n1</property><factor>0.008</factor><offset>0.2</offset></pitch>
   <reference-dist>40</reference-dist>
   <max-dist>5000</max-dist>
  </engine>

  <engine>
   <name>ext-roar</name>
   <mode>looped</mode>
   <path>Sounds/GEED/full_mil_aft_mono.wav</path>
   <condition>
    <not><property>/sim/current-view/internal</property></not>
    <greater-than><property>/engines/engine[0]/thrust_lb</property><value>2000</value></greater-than>
   </condition>
   <volume><property>/engines/engine[0]/thrust_lb</property><factor>0.00005</factor><max>1</max></volume>
   <reference-dist>40</reference-dist>
   <max-dist>5000</max-dist>
  </engine>

  <engine>
   <name>ext-afterburner</name>
   <mode>looped</mode>
   <path>Sounds/GEED/afterburner_exterior.wav</path>
   <condition>
    <not><property>/sim/current-view/internal</property></not>
    <property>/engines/engine[0]/augmentation</property>
   </condition>
   <!-- JSBSim throttle position 1 (min afterburner) to 2 (max): 0.4 to 1 -->
   <volume><property>/fdm/jsbsim/fcs/throttle-pos-norm</property><offset>-0.6</offset></volume>
   <reference-dist>60</reference-dist>
   <max-dist>6000</max-dist>
  </engine>

  <!-- Engine, in the cockpit -->
  <engine>
   <name>int-idle</name>
   <mode>looped</mode>
   <path>Sounds/GEED/interior_ground_stereo.wav</path>
   <condition>
    <property>/sim/current-view/internal</property>
    <greater-than><property>/engines/engine[0]/n2</property><value>5</value></greater-than>
   </condition>
   <volume><property>/engines/engine[0]/n2</property><factor>0.011</factor><max>0.7</max></volume>
   <pitch><property>/engines/engine[0]/n2</property><factor>0.01</factor><offset>0.47</offset></pitch>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </engine>

  <engine>
   <name>int-whine</name>
   <mode>looped</mode>
   <path>Sounds/GEED/interior_whine_60perc_3400hz_mono.wav</path>
   <condition>
    <property>/sim/current-view/internal</property>
    <greater-than><property>/engines/engine[0]/n2</property><value>10</value></greater-than>
   </condition>
   <volume><property>/engines/engine[0]/n2</property><factor>0.004</factor><max>0.4</max></volume>
   <!-- recorded at 60% N2 (pitch offsets default to 1) -->
   <pitch><property>/engines/engine[0]/n2</property><factor>0.0167</factor><offset>0</offset></pitch>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </engine>

  <engine>
   <name>int-afterburner</name>
   <mode>looped</mode>
   <path>Sounds/GEED/afterburner_interior.wav</path>
   <condition>
    <property>/sim/current-view/internal</property>
    <property>/engines/engine[0]/augmentation</property>
   </condition>
   <volume><property>/fdm/jsbsim/fcs/throttle-pos-norm</property><offset>-0.7</offset></volume>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </engine>

  <!-- Airflow -->
  <wind>
   <name>wind</name>
   <mode>looped</mode>
   <path>Sounds/engine/deep-noise.wav</path>
   <condition>
    <greater-than><property>/velocities/airspeed-kt</property><value>40</value></greater-than>
   </condition>
   <volume><property>/velocities/airspeed-kt</property><factor>0.001</factor><max>0.6</max></volume>
   <pitch><property>/velocities/airspeed-kt</property><factor>0.0012</factor><offset>0.7</offset></pitch>
   <reference-dist>10</reference-dist>
   <max-dist>500</max-dist>
  </wind>

  <!-- Gear -->
  <gear>
   <name>gear-transit</name>
   <mode>in-transit</mode>
   <path>Sounds/gear-transit.wav</path>
   <property>/gear/gear[0]/position-norm</property>
   <volume><factor>0.8</factor></volume>
   <reference-dist>10</reference-dist>
   <max-dist>300</max-dist>
  </gear>

  <gear>
   <name>gear-lock-down</name>
   <mode>once</mode>
   <path>Sounds/gear-lock.wav</path>
   <condition>
    <greater-than><property>/gear/gear[0]/position-norm</property><value>0.99</value></greater-than>
    <greater-than><property>/sim/time/elapsed-sec</property><value>3</value></greater-than>
   </condition>
   <reference-dist>10</reference-dist>
   <max-dist>300</max-dist>
  </gear>

  <gear>
   <name>gear-lock-up</name>
   <mode>once</mode>
   <path>Sounds/gear-lock.wav</path>
   <condition>
    <less-than><property>/gear/gear[0]/position-norm</property><value>0.01</value></less-than>
    <greater-than><property>/sim/time/elapsed-sec</property><value>3</value></greater-than>
   </condition>
   <volume><factor>0.7</factor></volume>
   <reference-dist>10</reference-dist>
   <max-dist>300</max-dist>
  </gear>

  <gear>
   <name>touchdown</name>
   <mode>once</mode>
   <path>Sounds/touchdown.wav</path>
   <condition>
    <or>
     <property>/gear/gear[1]/wow</property>
     <property>/gear/gear[2]/wow</property>
    </or>
    <less-than><property>/velocities/vertical-speed-fps</property><value>-1</value></less-than>
   </condition>
   <volume><property>/velocities/groundspeed-kt</property><factor>0.006</factor><max>1</max></volume>
   <reference-dist>10</reference-dist>
   <max-dist>500</max-dist>
  </gear>

  <gear>
   <name>ground-roll</name>
   <mode>looped</mode>
   <path>Sounds/ground_roll.wav</path>
   <condition>
    <or>
     <property>/gear/gear[0]/wow</property>
     <property>/gear/gear[1]/wow</property>
     <property>/gear/gear[2]/wow</property>
    </or>
    <greater-than><property>/gear/gear[1]/rollspeed-ms</property><value>2</value></greater-than>
   </condition>
   <volume><property>/velocities/groundspeed-kt</property><factor>0.005</factor><max>0.8</max></volume>
   <pitch><property>/velocities/groundspeed-kt</property><factor>0.003</factor><offset>0.8</offset></pitch>
   <reference-dist>10</reference-dist>
   <max-dist>300</max-dist>
  </gear>

  <!-- Speed brake and canopy motors -->
  <speedbrake>
   <name>speedbrake</name>
   <mode>in-transit</mode>
   <path>Sounds/speedbrake.wav</path>
   <property>/surface-positions/speedbrake-pos-norm</property>
   <volume><factor>0.6</factor></volume>
   <reference-dist>10</reference-dist>
   <max-dist>200</max-dist>
  </speedbrake>

  <canopy>
   <name>canopy</name>
   <mode>in-transit</mode>
   <path>Sounds/f16_canopy.wav</path>
   <property>/fdm/jsbsim/fcs/canopy-pos-norm</property>
   <volume><factor>0.8</factor></volume>
   <reference-dist>5</reference-dist>
   <max-dist>100</max-dist>
  </canopy>

 </fx>
</PropertyList>
